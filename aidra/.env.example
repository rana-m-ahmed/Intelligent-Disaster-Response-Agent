# Example environment variables for running AIDRA in production
# Copy to `.env` or export in your environment as needed.

# Flask secret key
SECRET_KEY=changeme_replace_in_production

# Host and port for the Flask-SocketIO server
HOST=127.0.0.1
PORT=5001

# Set to 'true' to enable Flask debug mode (not recommended for production)
FLASK_DEBUG=false

# When 'true', ML models will be trained on startup if pickles are missing.
# Default is 'false' to avoid expensive training during app startup.
ML_TRAIN_ON_STARTUP=false
